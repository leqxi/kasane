{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": { "includes": ["src/**", "tests/**", "scripts/**", "*.ts"] },

  // Biome lints this code; it does not lay it out. The source is set by hand — a signature broken
  // across lines that would fit on one, a comment wrapped to read as a paragraph — and no line
  // width reproduces those choices, so turning the formatter on would flatten them and call it
  // tidy. `.editorconfig` carries the indentation any editor needs to honour.
  "formatter": { "enabled": false },

  // Pinned exactly in devDependencies, so a lint rule added in a later release lands in a pull
  // request that says so rather than in whichever build runs next.
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
